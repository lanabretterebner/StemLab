         if (canDrop)
         {
             sendExternalDragAndDropDrop();
+
+            // STEMLAB_DND_PATCH: the gesture is over the moment the drop is
+            // sent. The data handshake (SelectionRequest -> XdndFinished)
+            // carries on by itself, and a target that never sends
+            // XdndFinished used to leave `dragging` set for the life of the
+            // process, refusing every later drag.
+            externalDragGestureFinished();
         }
         else
