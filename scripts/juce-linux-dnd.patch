@@ -349,9 +356,24 @@ public:
             X11Symbols::getInstance()->xUngrabPointer (getDisplay(), CurrentTime);
         }
 
-        NullCheckedInvocation::invoke (completionCallback);
+        externalDragGestureFinished();
+    }
 
-        dragging = false;
+    /*
+        STEMLAB_DND_PATCH: everything a finished gesture must not leave behind
+        for the next one. The callback is invoked here and then cleared, so a
+        late XdndFinished cannot run it twice and a target that never sends one
+        cannot swallow it entirely.
+    */
+    void externalDragGestureFinished()
+    {
+        dragging        = false;
+        canDrop         = false;
+        expectingStatus = false;
+        silentRect      = {};
+
+        NullCheckedInvocation::invoke (completionCallback);
+        completionCallback = nullptr;
     }
 
     bool externalDragInit (::Window window, bool text, const String& str, std::function<void()>&& cb)
