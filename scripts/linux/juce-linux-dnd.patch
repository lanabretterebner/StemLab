     }
 
     bool externalDragInit (::Window window, bool text, const String& str, std::function<void()>&& cb)
     {
+        // STEMLAB_DND_PATCH: a fresh drag starts from a clean machine, and the
+        // source never targets its own window - the real target is discovered
+        // by the first motion. Targeting itself here sent an XdndEnter to its
+        // own window, whose accepting reply could then be mistaken for the
+        // real target's answer.
+        canDrop         = false;
+        expectingStatus = false;
+        silentRect      = {};
+        allowedTypes.clearQuick();
+
         windowH            = window;
         isText             = text;
         textOrFiles        = str;
-        targetWindow       = windowH;
+        targetWindow       = None;
         completionCallback = std::move (cb);
 
         auto* display = getDisplay();
@@ -385,9 +427,9 @@ public:
                                                         reinterpret_cast<const unsigned char*> (allowedTypes.getRawDataPointer()), allowedTypes.size());
 
             dragging = true;
-            xdndVersion = getDnDVersionForWindow (targetWindow);
 
-            sendExternalDragAndDropEnter();
+            // STEMLAB_DND_PATCH: no XdndEnter to our own window - the first
+            // motion finds the real target and greets that one.
             handleExternalDragMotionNotify();
 
             return true;
