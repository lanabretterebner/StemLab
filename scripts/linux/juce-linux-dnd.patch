     void handleExternalDragAndDropStatus (const XClientMessageEvent& clientMsg)
     {
+        // STEMLAB_DND_PATCH: only the current target's answer counts. A status
+        // that a previous target sent late (another toplevel of the same
+        // application, typically) used to be consumed as this target's answer,
+        // and the real answer that followed was then thrown away.
+        if ((::Window) clientMsg.data.l[0] != targetWindow)
+            return;
+
         if (expectingStatus)
         {
             expectingStatus = false;
@@ -115,10 +122,21 @@ public:
         if (canDrop)
         {
             sendExternalDragAndDropDrop();
+
+            // STEMLAB_DND_PATCH: the gesture is over; the data handshake
+            // (SelectionRequest -> XdndFinished) continues on its own. Keeping
+            // `dragging` set until XdndFinished arrived meant a target that
+            // never sends it blocked every future drag, and mouse input kept
+            // driving the finished drag in the meantime.
+            dragging = false;
+            canDrop = false;
+            expectingStatus = false;
         }
         else
         {
-            sendExternalDragAndDropLeave();
+            if (targetWindow != None)
